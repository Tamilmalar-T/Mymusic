PORT=5000
JWT_SECRET=mymusic_secret_key_12345

# POSTGRESQL CONNECTION STRING (Example: postgres://username:password@localhost:5432/database_name)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mymusic

# Or Individual PostgreSQL credentials (used if DATABASE_URL is not set):
PGUSER=postgres
PGHOST=localhost
PGDATABASE=mymusic
PGPASSWORD=postgres
PGPORT=5432
